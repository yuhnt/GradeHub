# Postgres container (docker-compose.yml)
DB_USER="admin_grade"
DB_PASSWORD="change-me"
DB_NAME="taskgrade"
PGADMIN_DEFAULT_EMAIL="admin@admin.com"
PGADMIN_DEFAULT_PASSWORD="change-me"

# Special characters in the password must be URL-encoded here (e.g. $ -> %24, # -> %23)
DATABASE_URL="postgresql://admin_grade:change-me@localhost:5433/taskgrade?schema=public"

JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"
BCRYPT_SALT_ROUNDS=10

PORT=3000

UPLOAD_DIR="uploads"

RESET_TOKEN_EXPIRY_MINUTES=30

# Password reset emails over SMTP (Nodemailer).
#   Empty SMTP_HOST  -> tokens are printed to the server console (default).
#   SMTP_HOST="ethereal" -> fake inbox, no signup; the console prints a link to view each email.
#   Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, SMTP_USER=you@gmail.com,
#          SMTP_PASS=<16-char App Password from myaccount.google.com/apppasswords>
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Task Grading Hub <you@gmail.com>"
# Optional frontend page that reads ?token=...; without it the email contains the raw token.
RESET_PASSWORD_URL=""
