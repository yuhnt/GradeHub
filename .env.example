# Settings for the full stack in docker-compose.yml (not for local `npm run dev`;
# that uses backend/.env). Copy to .env and fill in the values marked REQUIRED.

# Public address of the site, used in password reset links and for CORS.
APP_URL="http://localhost:8080"
# Host port nginx listens on.
HTTP_PORT=8080

# Images to run. CI publishes these to GitHub Container Registry;
# IMAGE_TAG can pin a release (e.g. 1.1.0 or sha-3f2c1ab) for rollbacks.
BACKEND_IMAGE="ghcr.io/yuhnt/gradehub-backend"
FRONTEND_IMAGE="ghcr.io/yuhnt/gradehub-frontend"
IMAGE_TAG="latest"

# Database. REQUIRED: DB_PASSWORD, letters and digits only (it goes into a URL).
# Generate one with: openssl rand -hex 24
DB_USER="gradehub"
DB_PASSWORD=""
DB_NAME="gradehub"

# REQUIRED: a long random string. Changing it signs everyone out.
# Generate one with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN="1d"
BCRYPT_SALT_ROUNDS=10
RESET_TOKEN_EXPIRY_MINUTES=30

# Password reset emails. Leave SMTP_HOST empty to log reset tokens to the
# backend container's output instead (docker compose logs backend).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Task Grading Hub <no-reply@example.com>"
