{
  "name": "task-grading-hub-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Web client for Task Grading Hub: teachers post and grade tasks, students submit PDFs",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
