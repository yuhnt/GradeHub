# Base URL of the API, without the trailing /api. Leave empty to call the
# API on the same origin (the Vite dev proxy locally, nginx in Docker).
# Set it only when the API lives on another origin, e.g.
# VITE_API_URL="https://api.grading.example.com" (the backend must then list
# this site in CORS_ORIGIN).
VITE_API_URL=""

# Where the Vite dev server forwards /api requests (development only).
DEV_API_PROXY_TARGET="http://localhost:3000"
